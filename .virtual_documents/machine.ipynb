import numpy
# مهم نیست و خطایی نمیدهد اگر در ادامه دوباره ایمپورت کنیم اما بهتر است یبار بیشتر انجام ندهیم


yek = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
    ]
print(type(yek))


nyek = numpy.array(yek)
nyek


numpy.diag(nyek)


matrix = numpy.zeros((2, 2))
matrix


numpy.diag(matrix)


matrix = numpy.ones((4, 4))


matrix


numpy.diag(matrix)


m1 = numpy.zeros((3, 4), int)
m1


m2 = numpy.ones((3, 4), int)
m2


numpy.vstack([m1, m2])
# V : VERTICAL عمودی
# برای این دستور باید تعداد مولفه های دوم(ستون ها) در هر لیست برابر باشد


numpy.hstack([m1, m2])
# H : HORIZONTLE افقی
# برای این دستور باید تعداد مولفه های اول(سطر ها) در هر لیست برابر باشد


# برای اجرای دو دستور بالا، ترتیب ورودی ها در ترتیب خروجی موثر است


[1, 2, 3] * [4, 5, 6]
# ضرب لیست ها بدون تبدیل آنها به نامپای امکان پذیر نیست


x = numpy.array([1, 2, 3])
y = numpy.array([4, 5, 6])
z = x * y
z


x ** 2


x.dot(y)
# dot : ضرب داتی یعنی ضرب نظیر به نظیر عناصر هر لیست با ترتیب اولی در اولی، دومی در دومی، ... و در آحر جمع همه ی انها باهم


nyek


nyek.T
# T = TRANSE جای سطر ها را با ستون ها عوض میکند
# We should write T NOT t
# ndo = nyek.T این دستور یک متغیر دیگر تعرف نمیکند و به متغیر دیگر دست نمیزند گویی این دستور را وارد کرده ایم


nyek.astype('f')
# تایپ را از حالت اینتیجر(عدد صحیح) به فلوت(عدداعشاری) در یک متغیر دیگر تغییر میدهد


nyek.sum()
# جمع مقادیر عناصر جداول


nyek.max()
# بزرگترین مقدار جداول را نشان میدهد


nyek.min()
# کوچکترین مقدار جداول را نشان میدهد


nyek.argmax()
# جایگاه(ایندکس) بزرگترین عدد را نشان میدهد که چندمین عنصر ماتریس است(فرایند شمارش از صفر شروع میشود)


nyek.argmin()
# جایگاه(ایندکس) کوچکترین عدد را نشان میدهد که چندمین عنصر ماتریس است(فرایند شمارش از صفر شروع میشود)


nyek.mean()
# میانگین عناصر


nyek.std()
# انحراف استاندارد عناصر


mr = numpy.arange(15) ** 2
# یعنی از رنج صفر تا چهارده(پانزده عدد) یک آرایه ی نامپایی بساز و در آخر به توان دو کن
mr


mr[2]
# یعنی ایندکس دو را به من نشان بده


mr[2 : 6]
# یعنی ایندکس دو تا شش را به من نشان بده


mr[ : 6]
# یعنی ایندکس هیچی(اول) تا شش را به من نشان بده


mr[6 : ]
# یعنی ایندکس شش تا هیچی(آخر) را به من نشان بده


mr[-5 : ]
# یعنی ایندکس از آخر پنجی تا آخر را به من نشان بده


mr[ : -2]
# یعنی از هیچی(اول) تا از آخر دومی را به من نشان بده


mr[4 : 13 : 2]
# از ایندکس چهار تا سیزده، دوتا دوتا برو جلو و انتخاب کن و به من نشان بده


mr[4 : : 2] 
#  or mr[4::2]
# یعنی از ایندکس چهار تا هیچی(آخر) دوتا دوتا برو جلو و انتخاب کن و به من نشان بده


mr[4 : : -2]
# یعنی از ایندکس چهار تا هیچی(چون قدم برداری معکوسه، پایان این دستور همان اول است) دوتا دوتا برو عقب و انتخاب کن و به من نشان بده


mr[-10 : -2 : 2]
# یعنی از ایندکس از آخر دهمی تا از آز آخر دومی دوتا دوتا برو جلو و به من نشان بده


nyek


nyek[0:2, 1:3]


nyek[::2, ::2]


nyek[-2::1, -3::2]


nyek[-2::1, -2]


nyek[::-1, 2:]


nyek[nyek >= 0]


nyek[nyek <= 0]


nyek[nyek >= 4]


nyek >= 0


nyek <= 0


nyek >= 4


# از اینجا
myek = nyek[-1]
myek


myek[:] = 1
myek


myek[:2] = 4
myek


nyek
# تا اینجا
# متوجه شدیم که اگر یه قسمتی از یک ماتریس را در یک متغیر دیگر بریزیم، محتوای آن قسمت از ماتریس در متغیر کپی نمیشود بلکه آدرس آن قسمت از ماتریس، به متغیر جدید داده می شود(گویی یک اسم به آن قسمت از ماتریس داده ایم)
# پس اگر تغییری در متغیر جدیدی دهیم درواقع داریم روی آن آدرس  تغییر ایجاد میکنیم، و درنتیجه آن قسمت از ماتریس نیز تغییر می کند
# این به بهینه بودن رم کمک میکند زیرا در ماتریس های واقعی با داده های سنگین اگر بخوایم واقعن کار کپی را انجام دهیم بخش بزرگی از رم اشغال می شود


# برای کپی کردن واقعی این گونه عمل میکنیم
oyek = nyek.copy()
oyek


oyek[::2] = 16 
oyek


nyek
# همانطور که دیدید تغییری روی ماتریس اصلی با این نوع کپی کردن صورت نگرفت زیرا هرکدام آدرس مختلفی روی حافظه دارند
# This is 'copy by values' which is not default in numpy!


tyek = numpy.random.randint(0, 10, (8, 6))
tyek


tyek[::3, ::-2]



